+                        parsed > (std::numeric_limits<int>::max() - (*p - '0')) / 10) return fallback;
+                    parsed = 10 * parsed + (*p - '0');
+                }
+                return parsed > 0 ? parsed : fallback;
+            };
+            info.devices[i].nsm = positive_env("GGML_SYCL_TEST_NSM", info.devices[i].nsm);
+            info.devices[i].max_wg_per_cu = positive_env("GGML_SYCL_TEST_MAX_WG_PER_CU", info.devices[i].max_wg_per_cu);
+            fprintf(stderr, "GGML_SYCL_TEST_CPU: launch geometry nsm=%d max_wg_per_cu=%d\n",
