# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Build
build/
build-*/
cmake-build-*/
*.o
*.a
*.so
*.spv
*.bin
*.progbin

# Secrets
.env
.env.*
*.pem
*.key

# Models and large artefacts (never commit weights)
*.gguf
*.safetensors
models/

# Profiler output: summaries are committed under profiles/, raw results are not
profiles/raw/
r[0-9][0-9][0-9]*/
*.vtune
*.amplxe
unitrace*.json
*.pftrace

# Agent receipts: logs stay local; ticket results are summarized in PRs
state/receipts/*.log
state/receipts/*.md
!state/receipts/.gitkeep

# Local overrides
CLAUDE.local.md
.worktrees/
third_party/*
!third_party/.gitkeep
!third_party/patches/

# Local toolchain (docs/TOOLCHAIN.md)
.venv/
tools/
bench/models.txt

# Python bytecode
__pycache__/
*.pyc

# Raw benchmark logs stay local (gzipped copies / summaries are committed)
bench/results/**/*.err
bench/results/**/build*.log
bench/results/**/fa-test*.txt
bench/results/**/fa-support*.txt
